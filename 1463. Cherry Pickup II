class Solution {
    vector<vector<int>> grid;
    vector<vector<vector<int>>> dp;
    int n, m;

    int solve(int i, int j1, int j2) {
        // Out of bounds
        if (j1 < 0 || j1 >= m || j2 < 0 || j2 >= m)
            return -1e9;

        // Base case
        if (i == n - 1) {
            if (j1 == j2)
                return grid[i][j1];
            return grid[i][j1] + grid[i][j2];
        }

        // Memoization
        if (dp[i][j1][j2] != -1)
            return dp[i][j1][j2];

        // Current cherries
        int cherries = 0;
        if (j1 == j2)
            cherries = grid[i][j1];
        else
            cherries = grid[i][j1] + grid[i][j2];

        int ans = 0;

        // Try all 9 possible moves
        for (int dj1 = -1; dj1 <= 1; dj1++) {
            for (int dj2 = -1; dj2 <= 1; dj2++) {
                ans = max(ans, cherries + solve(i + 1, j1 + dj1, j2 + dj2));
            }
        }

        return dp[i][j1][j2] = ans;
    }

public:
    int cherryPickup(vector<vector<int>>& grid) {
        this->grid = grid;
        n = grid.size();
        m = grid[0].size();

        dp.assign(n, vector<vector<int>>(m, vector<int>(m, -1)));

        return solve(0, 0, m - 1);
    }
};
